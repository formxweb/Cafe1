---
import Emblem from './brand/Emblem.astro';
import { site, sections as links } from '../data/site.js';
---

<header class="nav" data-nav data-state="top" data-theme="light">
  <div class="nav-bar wrap">
    <a class="nav-brand" href="#kapak" aria-label="La Joie, sayfanın başına dön">
      <Emblem class="nav-emblem" />
      <span class="nav-name serif" aria-hidden="true">La Joie</span>
    </a>

    <nav class="nav-links" aria-label="Bölümler">
      <ul>
        {
          links.map((link) => (
            <li>
              <a class="micro" href={link.href} data-nav-link>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="nav-meta">
      <span class="nav-status micro" data-open-status>{site.hours.label}</span>
      <a class="nav-phone micro num" href={site.phone.href}>{site.phone.display}</a>
    </div>

    <a class="nav-quick micro" href="#menu">Menü</a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="panel" data-nav-toggle>
      <span class="visually-hidden" data-nav-toggle-label>Bölümleri aç</span>
      <span class="nav-toggle-lines" aria-hidden="true"></span>
    </button>
  </div>
</header>

<div class="panel" id="panel" data-panel hidden>
  <nav class="panel-inner wrap" aria-label="Bölümler">
    <ol class="panel-links">
      {
        links.map((link, i) => (
          <li>
            <a href={link.href} data-panel-link>
              <span class="micro num">0{i + 1}</span>
              <span class="serif">{link.label}</span>
            </a>
          </li>
        ))
      }
    </ol>
    <div class="panel-meta">
      <p class="micro" data-open-status>{site.hours.label}</p>
      <a class="serif num" href={site.phone.href}>{site.phone.display}</a>
      <a class="micro link" href={site.instagram.url} target="_blank" rel="noopener">@{site.instagram.handle}</a>
      <p class="micro">{site.address.street}, {site.address.city}</p>
    </div>
  </nav>
</div>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    color: var(--ink);
    pointer-events: none;
  }

  .nav-bar {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: var(--nav-h);
    pointer-events: auto;
    transition:
      height var(--d-2) var(--ease),
      color var(--d-2) var(--ease);
  }

  /* Solid state: a paper strip with a hairline, drawn in from the top */
  .nav-bar::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--paper);
    box-shadow: 0 1px 0 var(--line);
    transform: translateY(-101%);
    transition:
      transform var(--d-2) var(--ease),
      background-color var(--d-2) var(--ease);
  }

  .nav[data-state='solid'] .nav-bar {
    height: calc(var(--nav-h) - 0.75rem);
  }

  .nav[data-state='solid'] .nav-bar::before {
    transform: none;
  }

  .nav[data-theme='dark'] {
    color: var(--paper);
  }

  .nav[data-theme='dark'] .nav-bar::before {
    background: var(--grove-deep);
    box-shadow: 0 1px 0 var(--line-on-dark);
  }

  /* Over the cover the bar is transparent and follows the cover's own theme */
  .nav[data-state='top'][data-theme='dark'] .nav-bar::before {
    transform: translateY(-101%);
  }

  .nav-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    justify-self: start;
  }

  .nav-brand :global(.nav-emblem) {
    width: 2.25rem;
    flex: none;
    transition: width var(--d-2) var(--ease);
  }

  .nav[data-state='solid'] :global(.nav-emblem) {
    width: 1.9rem;
  }

  .nav-name {
    font-size: 1.375rem;
    line-height: 1;
    white-space: nowrap;
    opacity: 0;
    transform: translateX(-0.5rem);
    transition:
      opacity var(--d-2) var(--ease),
      transform var(--d-2) var(--ease);
  }

  .nav[data-state='solid'] .nav-name {
    opacity: 1;
    transform: none;
  }

  .nav-links ul {
    display: flex;
    gap: clamp(1.25rem, 2.6vw, 2.75rem);
  }

  .nav-links a {
    position: relative;
    display: block;
    padding-block: 0.75rem;
  }

  /* The gold dot marks the chapter you are in */
  .nav-links a::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0.1rem;
    width: 5px;
    height: 5px;
    margin-left: -2.5px;
    border-radius: 50%;
    background: var(--gold);
    transform: scale(0);
    transition: transform var(--d-2) var(--ease);
  }

  .nav-links a[aria-current='true']::after {
    transform: scale(1);
  }

  @media (hover: hover) {
    .nav-links a:hover::after {
      transform: scale(1);
    }
  }

  .nav-meta {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    opacity: 0;
    transition: opacity var(--d-2) var(--ease);
  }

  .nav[data-state='solid'] .nav-status {
    opacity: 1;
  }

  .nav-quick,
  .nav-toggle {
    display: none;
  }

  @media (max-width: 1099px) {
    .nav-meta .nav-phone {
      display: none;
    }
  }

  @media (max-width: 899px) {
    .nav-bar {
      grid-template-columns: 1fr auto auto;
      gap: 0.25rem;
    }

    .nav-links,
    .nav-meta {
      display: none;
    }

    .nav-name {
      opacity: 1;
      transform: none;
    }

    .nav-quick {
      display: inline-flex;
      align-items: center;
      min-height: 2.75rem;
      padding-inline: 1rem;
    }

    .nav-toggle {
      display: grid;
      place-items: center;
      width: 2.75rem;
      height: 2.75rem;
      margin-right: -0.5rem;
    }
  }

  .nav-toggle-lines,
  .nav-toggle-lines::after {
    display: block;
    width: 1.5rem;
    height: 1.5px;
    background: currentColor;
    transition: transform var(--d-2) var(--ease);
  }

  .nav-toggle-lines {
    position: relative;
    transform: translateY(-3.5px);
  }

  .nav-toggle-lines::after {
    content: '';
    position: absolute;
    left: 0;
    width: 1rem;
    transform: translateY(7px);
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle-lines {
    transform: rotate(45deg);
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle-lines::after {
    width: 1.5rem;
    transform: rotate(-90deg);
  }

  /* ---- Mobile panel ---- */
  .panel {
    position: fixed;
    inset: 0;
    z-index: 40;
    background: var(--grove);
    color: var(--paper);
    overflow-y: auto;
    opacity: 0;
    transition: opacity var(--d-2) var(--ease);
  }

  .panel[hidden] {
    display: block;
    visibility: hidden;
    pointer-events: none;
  }

  .panel.is-open {
    opacity: 1;
  }

  .panel-inner {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--s-8);
    min-height: 100%;
    padding-top: calc(var(--nav-h) + var(--s-7));
    padding-bottom: var(--s-7);
  }

  .panel-links li {
    border-bottom: 1px solid var(--line-on-dark);
  }

  .panel-links a {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    padding-block: 0.9rem;
  }

  .panel-links .micro {
    color: var(--gold);
    min-width: 1.75rem;
  }

  .panel-links .serif {
    font-size: clamp(2.5rem, 12vw, 4rem);
  }

  .panel-links a {
    opacity: 0;
    transform: translateY(1rem);
    transition:
      opacity var(--d-2) var(--ease),
      transform var(--d-2) var(--ease);
  }

  .panel.is-open .panel-links a {
    opacity: 1;
    transform: none;
  }

  .panel.is-open .panel-links li:nth-child(2) a { transition-delay: 60ms; }
  .panel.is-open .panel-links li:nth-child(3) a { transition-delay: 120ms; }
  .panel.is-open .panel-links li:nth-child(4) a { transition-delay: 180ms; }
  .panel.is-open .panel-links li:nth-child(5) a { transition-delay: 240ms; }

  .panel-meta {
    display: grid;
    gap: var(--s-3);
    color: var(--muted-on-dark);
  }

  .panel-meta .serif {
    font-size: 2rem;
    color: var(--paper);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-bar,
    .nav-bar::before,
    .nav-name,
    .nav-brand :global(.nav-emblem),
    .nav-status,
    .panel,
    .panel-links a {
      transition: none;
    }
  }
</style>

<script>
  import { onFrame } from '../scripts/frame.js';

  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]')!;
  const toggleLabel = document.querySelector<HTMLElement>('[data-nav-toggle-label]')!;
  const panel = document.querySelector<HTMLElement>('[data-panel]')!;
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
  const themed = [...document.querySelectorAll<HTMLElement>('[data-nav-theme]')];
  const cover = document.getElementById('kapak');

  let panelOpen = false;

  // Solid bar after the cover, colour taken from whichever chapter sits under
  // the bar, gold dot on the chapter you are reading.
  function update() {
    if (panelOpen) {
      nav.dataset.state = 'top';
      nav.dataset.theme = 'dark';
      return;
    }
    const probe = nav.offsetHeight / 2;
    const coverEnd = cover ? cover.getBoundingClientRect().bottom : 0;
    nav.dataset.state = coverEnd > probe * 2 ? 'top' : 'solid';

    const under = themed.findLast((el) => el.getBoundingClientRect().top <= probe);
    nav.dataset.theme = under?.dataset.navTheme ?? 'light';

    const marker = window.innerHeight * 0.4;
    const current = links.findLast((link) => {
      const target = document.querySelector(link.hash);
      return target && target.getBoundingClientRect().top <= marker;
    });
    const currentEnd = current && document.querySelector(current.hash)!.getBoundingClientRect().bottom;
    links.forEach((link) =>
      link.setAttribute('aria-current', String(link === current && currentEnd! > marker)),
    );
  }
  onFrame(update);

  // Mobile panel
  const outside = [...document.querySelectorAll<HTMLElement>('main, footer')];

  function setOpen(open: boolean) {
    panelOpen = open;
    update();
    toggle.setAttribute('aria-expanded', String(open));
    toggleLabel.textContent = open ? 'Bölümleri kapat' : 'Bölümleri aç';
    outside.forEach((el) => (el.inert = open));
    document.documentElement.style.overflow = open ? 'hidden' : '';
    if (open) {
      panel.hidden = false;
      requestAnimationFrame(() => panel.classList.add('is-open'));
      panel.querySelector<HTMLElement>('a')?.focus();
    } else {
      panel.classList.remove('is-open');
      panel.hidden = true;
    }
  }

  toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  panel.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });
  matchMedia('(min-width: 900px)').addEventListener('change', (event) => {
    if (event.matches) setOpen(false);
  });
</script>
